# CISCO SSE API CREDENTIALS
CISCO_CLIENT_ID=your_cisco_client_id_here
CISCO_CLIENT_SECRET=your_cisco_client_secret_here

# DISCORD WEBHOOKS (Split-Custody)
DISCORD_PUBLIC_WEBHOOK=your_public_webhook_url_here
DISCORD_ADMIN_WEBHOOK=your_admin_webhook_url_here

# WEBEX NOTIFICATIONS
WEBEX_PUBLIC_WEBHOOK=your_public_webex_webhook_url_here
WEBEX_ADMIN_WEBHOOK=your_admin_webex_webhook_url_here

# SPLUNK CONFIGURATION PATHS (RDP LOCAL PATHS)
SPLUNK_ACCOUNT_CONFIG_PATH=C:\Program Files\Splunk\etc\apps\TA-cisco-cloud-security-addon\local\ta_cisco_cloud_security_addon_aws_account.conf
SPLUNK_INPUTS_CONFIG_PATH=C:\Program Files\Splunk\etc\apps\TA-cisco-cloud-security-addon\local\ta_cisco_cloud_security_addon_inputs.conf

# SPLUNK / S3 DETAILS
S3_BUCKET_NAME=your_bucket_name
S3_BUCKET_REGION=us-east-1
S3_DIRECTORY_PREFIX=your_prefix/
SPLUNK_INDEX=umbrella_logs

# LINE MESSAGING API (Split-Custody)
LINE_CHANNEL_ACCESS_TOKEN=your_line_token_here
LINE_USER_ID_DATA=user_id_of_data_custodian
LINE_USER_ID_KEY=user_id_of_key_custodian

# SENDGRID EMAIL API (Split-Custody)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDER_EMAIL=automation@yourcompany.com
RECIPIENT_EMAIL_DATA=admin_data@yourcompany.com
RECIPIENT_EMAIL_KEY=admin_key@yourcompany.com
